---
export interface NavItem {
  title: string;
  href: string;
  ariaLabel?: string;
}

export interface NavGroup {
  title: string;
  items: (NavItem | NavGroup)[];
}

interface Props {
  node: NavItem | NavGroup;
  currentPath: string;
}

const { node, currentPath } = Astro.props;
const isGroup = 'items' in node;
---

{
  isGroup ? (
    <li class="mt-4 flex flex-col gap-2 first:mt-0">
      <h4 class="font-semibold text-neutral-900 dark:text-neutral-100">{node.title}</h4>
      <ul class="ml-1 flex flex-col gap-1 border-l border-neutral-800 pl-4">
        {node.items.map((childNode) => (
          <Astro.self node={childNode} currentPath={currentPath} />
        ))}
      </ul>
    </li>
  ) : (
    <li>
      <a
        href={node.href}
        aria-label={node.ariaLabel}
        class:list={[
          'block py-1 text-sm transition-colors',
          currentPath === node.href || currentPath === `${node.href}/`
            ? 'font-medium text-orange-500'
            : 'text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-200',
        ]}
      >
        {node.title}
      </a>
    </li>
  )
}
