---
import ChevronIcon from '@components/icons/ChevronIcon.astro';

export interface NavItem {
  title: string;
  href: string;
  ariaLabel?: string;
}

export interface NavGroup {
  title: string;
  items: NavNode[];
}

export type NavNode = NavItem | NavGroup;

interface Props {
  node: NavNode;
  currentPath: string;
}

const { node, currentPath } = Astro.props;
const isGroup = 'items' in node;

function isCurrent(path: string, href: string): boolean {
  return path === href || path === `${href}/`;
}

function hasActive(node: NavNode, path: string): boolean {
  return 'href' in node ? isCurrent(path, node.href) : node.items.some((child) => hasActive(child, path));
}

const isCurrentItem = !isGroup && hasActive(node, currentPath);
const isActiveGroup = isGroup && hasActive(node, currentPath);
---

{
  isGroup ? (
    <li class="flex flex-col gap-2">
      <div class="flex items-center justify-between gap-2">
        <h4 class:list={['text-base', isActiveGroup ? 'text-orange-500' : 'text-neutral-900 dark:text-neutral-100']}>
          {node.title}
        </h4>
        <ChevronIcon width={20} height={20} class="w-5" />
      </div>
      <ul class="ml-1 flex flex-col gap-1 border-l border-neutral-800 pl-4">
        {node?.items.map((child) => (
          <Astro.self node={child} currentPath={currentPath} />
        ))}
      </ul>
    </li>
  ) : (
    <li>
      <a
        href={node.href}
        aria-label={node.ariaLabel}
        class:list={[
          'block py-1 text-sm transition-colors',
          isCurrentItem
            ? 'font-medium text-orange-500'
            : 'text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-200',
        ]}
      >
        {node.title}
      </a>
    </li>
  )
}
