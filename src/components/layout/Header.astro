---
import Logo from '@components/ui/Logo.astro';
import Search from '@components/icons/Search.astro';
import Github from '@components/icons/Github.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<header
  class:list={[
    'sticky top-0 z-50 flex items-center justify-between gap-4 border-b border-neutral-800 bg-neutral-950 px-4 py-2',
    className,
  ]}
>
  <a href="/">
    <Logo width={131.25} height={32} />
  </a>
  <div class="relative flex items-center gap-2 rounded-sm border border-neutral-800 p-2 w-[min(400px,100%)]">
    <button>
      <Search width={20} height={20} class="size-5 text-neutral-50" />
    </button>
    <input type="search" placeholder="Buscar..." class="outline-0" />
    <span class="absolute top-1/2 right-2 -translate-y-1/2 rounded-sm bg-neutral-900 px-2 text-sm">Ctrl + K</span>
  </div>
  <div class="flex items-center gap-2">
    <button class="">
      <Github width={24} height={24} class="size-6 text-neutral-50" />
    </button>
    <button class="">
      <Github width={24} height={24} class="size-6 text-neutral-50" />
    </button>
  </div>
</header>
