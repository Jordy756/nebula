---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside
  data-pagefind-ignore
  class="sticky top-[3.7rem] left-0 flex max-h-[calc(100vh-3.7rem)] flex-1 flex-col overflow-y-auto border-l border-neutral-800 p-4"
>
  <nav class="flex flex-col gap-2" aria-label="Tabla de contenidos">
    <h3 class="text-lg font-semibold text-neutral-50">En esta página</h3>
    <ul class="flex flex-col gap-2 text-sm">
      <li class="relative pl-2 text-neutral-300 transition-[color] duration-300 ease-in-out hover:text-neutral-200">
        <a href="#top" data-toc-link class="toc-link">Inicio</a>
      </li>
      {
        filteredHeadings.map((heading) => (
          <li
            class:list={[
              'relative text-neutral-400 transition-[color] duration-300 ease-in-out hover:text-neutral-200',
              heading.depth === 2 ? 'pl-2' : 'pl-6',
            ]}
          >
            <a href={`#${heading.slug}`} data-toc-link data-heading-slug={heading.slug} class="toc-link">
              {heading.text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script src="../../scripts/lib/toc.ts"></script>
