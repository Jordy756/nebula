---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside
  data-pagefind-ignore
  class="sticky top-14.75 left-0 flex max-h-[calc(100vh-59px)] flex-1 flex-col overflow-y-auto border-l border-neutral-800 p-4"
>
  <nav class="flex flex-col gap-2" aria-label="Tabla de contenidos">
    <h3 class="text-lg font-semibold">En esta página</h3>
    <ul class="flex flex-col gap-2 text-sm">
      <li class="pl-2 text-neutral-300">
        <a href="#top">Inicio</a>
      </li>
      {
        filteredHeadings.map((heading) => (
          <li class:list={[heading.depth === 2 ? 'pl-2 text-neutral-300' : 'pl-6 text-neutral-400', '']}>
            <a href={`#${heading.slug}`}>{heading.text}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
