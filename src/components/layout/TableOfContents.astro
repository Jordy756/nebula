---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<aside
  data-pagefind-ignore
  class="sticky top-[3.7rem] left-0 flex max-h-[calc(100vh-3.7rem)] flex-1 flex-col overflow-y-auto p-4"
>
  <nav class="flex flex-col gap-2" aria-label="Tabla de contenidos">
    <h3 class="text-lg font-semibold text-neutral-50">En esta página</h3>
    <ul class="relative flex flex-col" data-toc-container>
      {
        filteredHeadings.map((heading, index) => {
          const isH2 = heading.depth === 2;
          const prevHeading = filteredHeadings[index - 1];
          const prevIsH3 = prevHeading && prevHeading.depth === 3;

          return (
            <li class="relative" data-toc-item data-depth={heading.depth}>
              <a
                href={`#${heading.slug}`}
                data-toc-link
                data-heading-slug={heading.slug}
                class="prose relative block scroll-m-4 py-1.5 text-sm wrap-anywhere text-neutral-400 transition-colors duration-300 ease-in-out hover:text-neutral-200 data-[active=true]:text-neutral-50"
                style={`padding-inline-start: ${isH2 ? '20px' : '32px'};`}
              >
                <svg
                  class={`absolute -inset-s-1.5 top-0 -z-1 h-full rtl:-scale-x-100 ${isH2 ? 'bottom-1.5' : 'bottom-0'}`}
                  style={`width: ${isH2 ? '17px' : '25px'};`}
                  data-toc-connector
                >
                  {isH2 ? (
                    prevIsH3 ? (
                      <g data-toc-line>
                        <path
                          d="M 16.5 0 C 16.5 8 8.5 4 8.5 12"
                          stroke-width="1"
                          fill="none"
                          class="stroke-neutral-800"
                        />
                        <line x1="8.5" y1="12" x2="8.5" y2="100%" stroke-width="1" class="stroke-neutral-800" />
                      </g>
                    ) : (
                      <line
                        x1="8.5"
                        y1={index === 0 ? '6' : '0'}
                        x2="8.5"
                        y2="100%"
                        stroke-width="1"
                        class="stroke-neutral-800"
                        data-toc-line
                      />
                    )
                  ) : prevIsH3 ? (
                    <line
                      x1="16.5"
                      y1="0"
                      x2="16.5"
                      y2="100%"
                      stroke-width="1"
                      class="stroke-neutral-800"
                      data-toc-line
                    />
                  ) : (
                    <g data-toc-line>
                      <path
                        d="M 8.5 0 C 8.5 8 16.5 4 16.5 12"
                        stroke-width="1"
                        fill="none"
                        class="stroke-neutral-800"
                      />
                      <line x1="16.5" y1="12" x2="16.5" y2="100%" stroke-width="1" class="stroke-neutral-800" />
                    </g>
                  )}
                </svg>
                {heading.text}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>

<script src="../../scripts/lib/toc.ts"></script>
