---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

type ConnectorType = 'straight' | 'curve-down' | 'curve-up' | 'straight-deep';

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const getConnectorType = (heading: MarkdownHeading, prev: MarkdownHeading | undefined): ConnectorType => {
  const isH2 = heading.depth === 2;
  const prevIsH3 = prev?.depth === 3;

  if (isH2) return prevIsH3 ? 'curve-down' : 'straight';

  return prevIsH3 ? 'straight-deep' : 'curve-up';
};
---

<aside
  data-pagefind-ignore
  class="sticky top-[3.7rem] left-0 flex max-h-[calc(100vh-3.7rem)] flex-1 flex-col overflow-y-auto p-4"
>
  <nav class="flex flex-col gap-2" aria-label="Tabla de contenidos">
    <h3 class="text-lg font-semibold text-neutral-50">En esta página</h3>
    <ul class="relative flex flex-col" data-toc-container>
      {
        filteredHeadings.map((heading, index) => {
          const isH2 = heading.depth === 2;
          const prev = filteredHeadings[index - 1];
          const connectorType = getConnectorType(heading, prev);

          return (
            <li
              class:list={[
                'relative flex py-1.25 text-sm text-neutral-400 transition-colors duration-300 ease-in-out hover:text-neutral-200 data-[active=true]:text-neutral-50',
                isH2 ? 'ps-5' : 'ps-8',
              ]}
              data-toc-item
              data-depth={heading.depth}
            >
              <a href={`#${heading.slug}`} data-toc-link data-heading-slug={heading.slug}>
                <svg class:list={['absolute -inset-s-2 top-0 -z-1 h-full']} data-toc-connector>
                  {connectorType === 'straight' && (
                    <line
                      x1="8.5"
                      y1="0"
                      x2="8.5"
                      y2="100%"
                      stroke-width="1"
                      class="stroke-red-500"
                      data-toc-line
                    />
                  )}

                  {connectorType === 'curve-down' && (
                    <g data-toc-line>
                      <path
                        d="M 16.5 0 C 16.5 8 8.5 4 8.5 12"
                        stroke-width="1"
                        fill="none"
                        class="stroke-yellow-500"
                      />
                      <line x1="8.5" y1="12" x2="8.5" y2="100%" stroke-width="1" class="stroke-yellow-800" />
                    </g>
                  )}

                  {connectorType === 'straight-deep' && (
                    <line
                      x1="16.5"
                      y1="0"
                      x2="16.5"
                      y2="100%"
                      stroke-width="1"
                      class="stroke-blue-500"
                      data-toc-line
                    />
                  )}

                  {connectorType === 'curve-up' && (
                    <g data-toc-line>
                      <path
                        d="M 8.5 0 C 8.5 8 16.5 4 16.5 12"
                        stroke-width="1"
                        fill="none"
                        class="stroke-green-500"
                      />
                      <line x1="16.5" y1="12" x2="16.5" y2="100%" stroke-width="1" class="stroke-cyan-500" />
                    </g>
                  )}
                </svg>
                {heading.text}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</aside>

<script src="../../scripts/lib/toc.ts"></script>
