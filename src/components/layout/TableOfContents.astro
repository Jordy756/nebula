---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const filteredHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const getLineX = (depth: number) => (depth >= 3 ? 16.5 : 8.5);

const links = filteredHeadings.map(({ slug, text, depth }, index) => {
  const prevDepth = index > 0 ? filteredHeadings[index - 1].depth : depth;
  const hasTransition = depth !== prevDepth;
  const x = getLineX(depth);
  const prevX = getLineX(prevDepth);
  const isLast = index === filteredHeadings.length - 1;
  const paddingStart = depth === 2 ? 20 : 32;
  const svgWidth = depth === 2 ? 17 : 25;

  return {
    slug,
    text,
    depth,
    index,
    x,
    prevX,
    hasTransition,
    isLast,
    paddingStart,
    svgWidth,
  };
});
---

<aside
  data-pagefind-ignore
  class="sticky top-[3.7rem] left-0 flex max-h-[calc(100vh-3.7rem)] flex-1 flex-col overflow-y-auto p-4"
>
  <nav class="flex flex-col gap-2" aria-label="Tabla de contenidos">
    <h3 class="text-lg font-semibold text-neutral-50">En esta página</h3>
    <ul class="relative z-10 flex flex-col" data-toc-container>
      {
        links.map(({ slug, text, depth, index, x, prevX, hasTransition, isLast, paddingStart, svgWidth }) => (
          <li class:list={['relative flex py-1.5 ps-2 text-sm first:pt-0']}>
            <a
              href={`#${slug}`}
              class="group w-full text-neutral-400 transition-colors duration-300 ease-in-out hover:text-neutral-200 data-[active=true]:text-red-500"
              data-toc-link
              data-heading-slug={slug}
              data-toc-index={index}
              style={`padding-inline-start: ${paddingStart}px;`}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class:list={['absolute inset-s-0 -top-1.5 -z-1 h-full rtl:-scale-x-100']}
                style={`width: ${svgWidth}px;`}
              >
                {hasTransition ? (
                  <>
                    <path
                      d={`M ${prevX} 0 C ${prevX} 8 ${x} 4 ${x} 12`}
                      stroke-width="1"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="stroke-neutral-50"
                    />
                    <line x1={x} y1="12" x2={x} y2="100%" stroke-width="1" class="stroke-neutral-50" />
                  </>
                ) : (
                  <line x1={x} y1="0" x2={x} y2="100%" stroke-width="1" class="stroke-neutral-50" />
                )}
              </svg>
              {text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>
