---
import { getCollection, type CollectionEntry } from 'astro:content';
import SidebarNode, { type NavNode } from './SidebarNode.astro';
import Logo from '@components/ui/Logo.astro';
import SearchTrigger from '@components/ui/SearchTrigger.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import LightIcon from '@components/icons/LightIcon.astro';
import DarkIcon from '@components/icons/DarkIcon.astro';

type Doc = CollectionEntry<'docs'>;

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentPath = Astro.url.pathname;

function buildTree(entries: Doc[]): NavNode[] {
  const levels = new Map<string, NavNode[]>([['', []]]);

  for (const {
    id,
    data: { title },
  } of entries) {
    const segments = id.split('/');
    segments.pop();
    let parentPath = '';

    for (const segment of segments) {
      const path = `${parentPath}/${segment}`;
      if (!levels.has(path)) {
        const items: NavNode[] = [];
        levels.set(path, items);
        levels.get(parentPath)!.push({ title, items });
      }
      parentPath = path;
    }

    levels.get(parentPath)!.push({ title, href: `/docs/${id}` });
  }

  return levels.get('')!;
}

const docs = await getCollection('docs');
const navigation = buildTree(docs);
// console.log(navigation);
---

<aside
  data-pagefind-ignore
  class:list={[
    'sticky top-0 left-0 flex max-h-screen flex-col items-end border-r border-neutral-800 bg-neutral-900',
    className,
  ]}
>
  <div class="flex h-full w-[min(100%,275px)] flex-col">
    <header class="flex flex-col gap-4 p-4">
      <h2 class="sr-only">Menú Lateral</h2>
      <a href="/" aria-label="Ir al inicio">
        <Logo width={100} height={24} />
      </a>
      <SearchTrigger />
    </header>
    <nav class="flex-1 overflow-y-auto p-4" aria-label="Navegación principal">
      <ul class="flex flex-col gap-2">
        {navigation.map((node) => <SidebarNode node={node} currentPath={currentPath} />)}
      </ul>
    </nav>
    <footer class="flex items-center gap-4 p-4">
      <a
        href="https://github.com/withastro/astro"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub de Astro"
      >
        <GithubIcon width={24} height={24} class="size-6" />
      </a>
      <a href="https://twitter.com/withastro" target="_blank" rel="noopener noreferrer" aria-label="Twitter de Astro">
        <LightIcon width={24} height={24} class="size-6" />
      </a>
      <a href="https://twitter.com/withastro" target="_blank" rel="noopener noreferrer" aria-label="Twitter de Astro">
        <DarkIcon width={24} height={24} class="size-6" />
      </a>
    </footer>
  </div>
</aside>
