---
import { getCollection } from 'astro:content';
import SidebarNode from './SidebarNode.astro';
import type { NavItem, NavGroup } from './SidebarNode.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentPath = Astro.url.pathname;

// ── build tree from flat collection ──────────────────
function humanize(name: string): string {
  return name
    .replace(/[-_]/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

interface TreeNode {
  item: { title: string; href: string };
  path: string[];
}

function buildTree(entries: { id: string; title: string }[]): (NavItem | NavGroup)[] {
  const tree: Record<string, any> = {};

  for (const entry of entries) {
    const segments = entry.id.split('/');
    let cursor = tree;

    for (let i = 0; i < segments.length - 1; i++) {
      const seg = segments[i];
      if (!cursor[seg]) cursor[seg] = {};
      cursor = cursor[seg];
    }

    cursor._items ??= [];
    cursor._items.push({
      title: entry.title,
      href: `/docs/${entry.id}`,
    });
  }

  function toNav(node: Record<string, any>): (NavItem | NavGroup)[] {
    const result: (NavItem | NavGroup)[] = [];

    for (const [key, val] of Object.entries(node)) {
      if (key.startsWith('_')) continue;
      const children = toNav(val);
      if (children.length > 0) {
        result.push({ title: humanize(key), items: children });
      }
    }

    if (node._items) {
      result.push(...node._items);
    }

    return result;
  }

  return toNav(tree);
}

// ── sort helpers ─────────────────────────────────────
const docs = await getCollection('docs');
const sorted = docs
  .map((d) => ({ id: d.id, title: d.data.title, order: d.data.order }))
  .sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || a.title.localeCompare(b.title));

const navigationTree = buildTree(sorted);
---

<aside
  class:list={[
    'sticky top-14.75 left-0 flex max-h-[calc(100vh-59px)] flex-col overflow-y-auto border-r border-neutral-800 p-4',
    className,
  ]}
>
  <nav class="flex flex-col gap-4" aria-label="Navegación principal">
    <ul class="flex flex-col gap-2">
      {navigationTree.map((node) => <SidebarNode node={node} currentPath={currentPath} />)}
    </ul>
  </nav>
</aside>
