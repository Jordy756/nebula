---
import { getCollection, type CollectionEntry } from 'astro:content';
import SidebarNode, { type NavNode } from './SidebarNode.astro';

type Doc = CollectionEntry<'docs'>;

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentPath = Astro.url.pathname;

function buildTree(entries: Doc[]): NavNode[] {
  const levels = new Map<string, NavNode[]>([['', []]]);

  for (const {
    id,
    data: { title },
  } of entries) {
    const segments = id.split('/');
    segments.pop();
    let parentPath = '';

    for (const segment of segments) {
      const path = `${parentPath}/${segment}`;
      if (!levels.has(path)) {
        const items: NavNode[] = [];
        levels.set(path, items);
        levels.get(parentPath)!.push({ title, items });
      }
      parentPath = path;
    }

    levels.get(parentPath)!.push({ title, href: `/docs/${id}` });
  }

  return levels.get('')!;
}

const docs = await getCollection('docs');
const navigation = buildTree(docs);
// console.log(navigation);
---

<aside
  data-pagefind-ignore
  class:list={[
    'sticky top-14.75 left-0 flex max-h-[calc(100vh-59px)] w-75 flex-col overflow-y-auto border-r border-neutral-800 p-4',
    className,
  ]}
>
  <nav class="flex flex-col gap-4" aria-label="Navegación principal">
    <ul class="flex flex-col gap-2">
      {navigation.map((node) => <SidebarNode node={node} currentPath={currentPath} />)}
    </ul>
  </nav>
</aside>
