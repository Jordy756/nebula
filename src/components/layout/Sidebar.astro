---
import { getCollection, type CollectionEntry } from 'astro:content';
import SidebarNode, { type NavGroup, type NavNode } from './SidebarNode.astro';

type Doc = CollectionEntry<'docs'>;

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentPath = Astro.url.pathname;

function humanize(segment: string): string {
  return segment
    .replace(/^\d+-/, '')
    .replace(/[-_]+/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
}

function buildTree(entries: Doc[]): NavNode[] {
  const root: NavNode[] = [];

  for (const entry of entries) {
    let level = root;
    for (const segment of entry.id.split('/').slice(0, -1)) {
      const title = humanize(segment);
      const last = level.at(-1);
      if (last && 'items' in last && last.title === title) {
        level = last.items;
      } else {
        const group: NavGroup = { title, items: [] };
        level.push(group);
        level = group.items;
      }
    }
    level.push({ title: entry.data.title, href: `/docs/${entry.id}` });
  }

  return root;
}

const docs = await getCollection('docs');
const navigation = buildTree(docs);
---

<aside
  class:list={[
    'sticky top-14.75 left-0 flex max-h-[calc(100vh-59px)] flex-col overflow-y-auto border-r border-neutral-800 p-4',
    className,
  ]}
>
  <nav class="flex flex-col gap-4" aria-label="Navegación principal">
    <ul class="flex flex-col gap-2">
      {navigation.map((node) => <SidebarNode node={node} currentPath={currentPath} />)}
    </ul>
  </nav>
</aside>
