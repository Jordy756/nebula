---
import { defaultLocale, useTranslations } from '@i18n/ui';
import ChevronIcon from '@components/icons/ChevronIcon.astro';

interface PageLink {
  href: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  prev?: PageLink;
  next?: PageLink;
}

const { title, description, prev, next } = Astro.props;
const locale = Astro.currentLocale ?? defaultLocale;
const t = useTranslations(locale);
---

<article data-pagefind-body class="flex max-w-[65ch] flex-col gap-4 px-4 py-12">
  <header class="flex flex-col gap-4 border-b border-neutral-800">
    <h1 data-pagefind-meta="title">{title}</h1>
    <p data-pagefind-meta="description" class="mb-12">{description}</p>
  </header>
  <div class="markdown-body flex flex-1 flex-col gap-4">
    <slot />
  </div>
  <footer class="mt-12 flex items-center gap-4">
    {
      prev && (
        <a
          href={prev.href}
          class="flex flex-1 flex-col gap-2 overflow-hidden rounded-sm border border-neutral-800 p-4 transition-[border-color] hover:border-neutral-600"
          rel="prev"
        >
          <span class="sr-only">{t('article.prev')}</span>
          <div class="flex items-center gap-1 font-semibold">
            <ChevronIcon class="size-5 rotate-90" aria-hidden="true" />
            <span>{prev.title}</span>
          </div>
          <p class="truncate">{prev.description}</p>
        </a>
      )
    }
    {
      next && (
        <a
          href={next.href}
          class="flex flex-1 flex-col justify-end gap-2 overflow-hidden rounded-sm border border-neutral-800 p-4 transition-[border-color] hover:border-neutral-600"
          rel="next"
        >
          <span class="sr-only">{t('article.next')}</span>
          <div class="flex items-center gap-1 self-end font-semibold">
            <span>{next.title}</span>
            <ChevronIcon class="size-5 -rotate-90" aria-hidden="true" />
          </div>
          <p class="truncate text-right">{next.description}</p>
        </a>
      )
    }
  </footer>
</article>
