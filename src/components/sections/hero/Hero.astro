---
import Button from '@components/ui/Button.astro';
import Link from '@components/ui/Link.astro';
import { getCurrentLocale } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
---

<section class="flex max-w-[65ch] flex-1 flex-col items-center justify-center gap-4 self-center text-center">
  <h1>Nebula</h1>
  <p class="text-center">
    Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ducimus excepturi, possimus maxime sunt dolore dicta,
    tempore deleniti quae, vero voluptatum et. Porro quo magni iure ipsum facere harum recusandae reiciendis?
  </p>
  <div class="flex gap-4">
    <Link href={`/${currentLocale}/docs/01-getting-started/01-getting-started`}>Get Started</Link>
    <Button variant="secondary">GitHub</Button>
  </div>
</section>
