---
import ChevronIcon from '@components/icons/ChevronIcon.astro';

export interface NavItem {
  title: string;
  href: string;
  ariaLabel?: string;
}

export interface NavGroup {
  title: string;
  items: NavNode[];
}

export type NavNode = NavItem | NavGroup;

interface Props {
  node: NavNode;
  currentPath: string;
}

const { node, currentPath } = Astro.props;
const isGroup = 'items' in node;

function isCurrent(path: string, href: string): boolean {
  return path === href || path === `${href}/`;
}

function hasActive(node: NavNode, path: string): boolean {
  return 'href' in node ? isCurrent(path, node.href) : node.items.some((child) => hasActive(child, path));
}

const isCurrentItem = !isGroup && hasActive(node, currentPath);
const isOpen = isGroup && hasActive(node, currentPath);
---

{
  isGroup ? (
    <li>
      <details open={isOpen} class="group sidebar-details">
        <summary class="group flex cursor-pointer items-center justify-between gap-2 py-1 pr-1 text-sm text-neutral-400 outline-none details-content:h-0 details-content:overflow-y-clip details-content:[transition:content-visibility_500ms_allow-discrete,height_500ms] open:details-content:h-auto hover:text-neutral-50">
          <span class="font-medium">{node.title}</span>
          <ChevronIcon
            width={16}
            height={16}
            class="size-4 rotate-0 text-neutral-500 transition-transform duration-300 group-open:rotate-90"
          />
        </summary>
        <div class="flex gap-3 pt-1">
          <div class="w-px bg-neutral-800 ml-2" />
          <ul class="flex flex-1 flex-col gap-1">
            {node.items.map((child) => (
              <Astro.self node={child} currentPath={currentPath} />
            ))}
          </ul>
        </div>
      </details>
    </li>
  ) : (
    <li>
      <a
        href={node.href}
        aria-label={node.ariaLabel}
        aria-current={isCurrentItem ? 'page' : undefined}
        class:list={[
          'block rounded-xs py-1 text-sm transition-colors',
          isCurrentItem ? 'font-medium text-vivid-crimson' : 'text-neutral-400 hover:text-neutral-50',
        ]}
      >
        {node.title}
      </a>
    </li>
  )
}
