---
import SearchIcon from '@components/icons/SearchIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<button
  command="show-modal"
  commandfor="search-modal"
  data-search-open
  aria-label={t('search.open')}
  class:list={[
    'flex items-center gap-2 rounded-sm md:border md:border-line md:p-2 md:text-neutral-600 md:dark:text-neutral-400',
    className,
  ]}
>
  <SearchIcon width={24} height={24} class="md:size-5 size-6" />
  <span class="flex-1 truncate text-left max-md:hidden">{t('search.open')}</span>
  <kbd
    class="hidden items-center rounded-sm bg-neutral-200 px-1.5 py-0.5 text-xs md:inline-flex dark:bg-neutral-800"
    >{t('search.shortcut')}</kbd
  >
</button>
