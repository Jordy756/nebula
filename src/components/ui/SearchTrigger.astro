---
import { defaultLocale, useTranslations, type Locale } from '@i18n/ui';
import SearchIcon from '@components/icons/SearchIcon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const locale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(locale);
---

<button
  command="show-modal"
  commandfor="search-modal"
  data-search-open
  aria-label={t('search.open')}
  class:list={['flex items-center gap-2 rounded-sm border border-neutral-800 p-2 text-neutral-400', className]}
>
  <SearchIcon width={20} height={20} class="size-5" />
  <span class="flex-1 truncate text-left">{t('search.open')}</span>
  <kbd class="hidden items-center rounded-sm bg-neutral-800 px-1.5 py-0.5 text-xs md:inline-flex"
    >{t('search.shortcut')}</kbd
  >
</button>
