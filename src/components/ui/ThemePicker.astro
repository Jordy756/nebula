---
import DarkIcon from '@components/icons/DarkIcon.astro';
import LightIcon from '@components/icons/LightIcon.astro';
---

<button
  id="theme-toggle"
  aria-label="Toggle theme"
  class="flex items-center gap-1 rounded-full bg-neutral-800 p-1 text-neutral-400"
>
  <span class="rounded-full bg-neutral-700 p-1">
    <LightIcon width={16} height={16} class="size-4 text-neutral-50" />
  </span>
  <span class="rounded-full p-1">
    <DarkIcon width={16} height={16} class="size-4" />
  </span>
</button>
