---
import DarkIcon from '@components/icons/DarkIcon.astro';
import LightIcon from '@components/icons/LightIcon.astro';
---

<button
  id="toggle-theme-btn"
  aria-label="Toggle theme"
  class="flex items-center gap-0.5 overflow-hidden rounded-full bg-neutral-800 p-0.5"
>
  <span class="rounded-full p-0.5">
    <LightIcon width={24} height={24} class="size-5 text-neutral-50 dark:text-neutral-800" />
  </span>
  <span class="rounded-full p-0.5 dark:bg-neutral-700">
    <DarkIcon width={24} height={24} class="size-5 text-neutral-800 dark:text-neutral-50" />
  </span>
</button>

<script src="../../scripts/lib/theme.ts"></script>
