---
import DarkIcon from '@components/icons/DarkIcon.astro';
import LightIcon from '@components/icons/LightIcon.astro';
---

<button
  id="toggle-theme-btn"
  aria-label="Toggle theme"
  class="rounded-sm border border-line bg-line/50 px-1.5 py-1 transition-opacity hover:opacity-75"
>
  <LightIcon width={20} class="block size-5 dark:hidden" />
  <DarkIcon width={20} class="hidden size-5 dark:block" />
</button>

<script>
  let toggleAbortController: AbortController | null = null;

  const setupThemeToggle = () => {
    const html = document.documentElement;
    const toggleThemeButton = document.getElementById('toggle-theme-btn');

    if (!toggleThemeButton) return;

    toggleAbortController?.abort();
    toggleAbortController = new AbortController();

    const handleThemeChange = () => {
      html.classList.toggle('dark');
      const isDark = html.classList.contains('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    };

    toggleThemeButton.addEventListener('click', handleThemeChange);
    toggleThemeButton.addEventListener('click', handleThemeChange, { signal: toggleAbortController.signal });
  };

  document.addEventListener('astro:page-load', setupThemeToggle);
</script>
