---
import DarkIcon from '@components/icons/DarkIcon.astro';
import LightIcon from '@components/icons/LightIcon.astro';
---

<button
  id="theme-toggle"
  aria-label="Toggle theme"
  class="flex items-center gap-0.5 overflow-hidden rounded-full bg-neutral-800 p-0.5"
>
  <span class="rounded-full bg-neutral-700">
    <LightIcon width={16} height={16} class="size-4 p-0.5 text-neutral-50" />
  </span>
  <span class="rounded-full">
    <DarkIcon width={16} height={16} class="size-4 p-0.5 text-neutral-400" />
  </span>
</button>
