---
import { getCurrentLocale, locales, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const currentPath = Astro.url.pathname.replace(`/${currentLocale}`, '') || '/';
---

<button
  type="button"
  popovertarget="language-picker"
  aria-label={t('languagePicker.label')}
  class={'rounded-xs bg-neutral-200 px-2 py-1 text-sm transition-opacity hover:opacity-75 dark:bg-neutral-800'}
>
  {currentLocale.toUpperCase()}
</button>

<ul
  id="language-picker"
  popover
  class="inset-auto mb-1 flex-col gap-1 rounded-sm border border-neutral-200 bg-neutral-100 p-1 position-area-top open:flex dark:border-neutral-800 dark:bg-neutral-900"
>
  {
    locales.map((locale) => (
      <li>
        <a
          href={`/${locale}${currentPath}`}
          hreflang={locale}
          aria-current={locale === currentLocale ? 'true' : undefined}
          class:list={[
            'block rounded-xs px-2 py-1 text-sm text-neutral-950 transition-[background-color] hover:bg-neutral-200 dark:text-neutral-50 dark:hover:bg-neutral-800',
            locale === currentLocale && 'bg-neutral-200 dark:bg-neutral-800',
          ]}
        >
          {locale.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>
