---
import { getCurrentLocale, locales, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const currentPath = Astro.url.pathname.replace(`/${currentLocale}`, '') || '/';
---

<button
  type="button"
  popovertarget="language-picker"
  aria-label={t('languagePicker.label')}
  class="rounded-xs bg-line px-2 py-1 text-sm transition-opacity hover:opacity-75"
>
  {currentLocale.toUpperCase()}
</button>

<ul
  id="language-picker"
  popover
  class="inset-auto mb-1 flex-col gap-1 rounded-sm border border-line bg-surface p-1 position-area-top open:flex"
>
  {
    locales.map((locale) => (
      <li>
        <a
          href={`/${locale}${currentPath}`}
          hreflang={locale}
          aria-current={locale === currentLocale ? 'true' : undefined}
          class:list={[
            'block rounded-xs px-2 py-1 text-sm text-foreground transition-[background-color] hover:bg-line',
            locale === currentLocale && 'bg-line',
          ]}
        >
          {locale.toUpperCase()}
        </a>
      </li>
    ))
  }
</ul>
