---
import SearchIcon from '@components/icons/SearchIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<dialog
  id="search-modal"
  closedby="any"
  data-pagefind-ignore
  class="top-1/2 left-1/2 max-h-[80vh] w-[min(700px,100%)] -translate-1/2 flex-col rounded-sm border border-line bg-surface transition-[opacity,translate,scale,overlay,display] will-change-[opacity,translate,scale] open:flex"
  aria-label={t('search.modalLabel')}
>
  <header class="flex items-center gap-2 p-4">
    <SearchIcon width={20} height={20} class="size-5" />
    <input
      id="search-input"
      type="search"
      placeholder={t('search.placeholder')}
      autofocus
      autocomplete="off"
      class="w-full outline-none"
    />
  </header>
  <ul id="search-results" class="flex flex-1 flex-col gap-8 overflow-auto p-4"></ul>
  <footer
    class="flex items-center justify-between gap-4 border-t border-line p-4 text-sm text-neutral-600 dark:text-neutral-400"
  >
    <button class="rounded-sm border border-line bg-line/50 px-2 py-1" command="close" commandfor="search-modal">
      <kbd>ESC</kbd>
    </button>
    <span id="search-status">0 {t('search.results')}</span>
  </footer>
</dialog>

<script src="../../scripts/lib/search.ts"></script>
