---
import SearchIcon from '@components/icons/SearchIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<dialog
  id="search-modal"
  closedby="any"
  data-pagefind-ignore
  class="animate-dialog max-h-[80vh] w-[min(700px,100%)] border border-line bg-surface"
  aria-label={t('search.modalLabel')}
>
  <header class="flex items-center gap-2 p-4">
    <SearchIcon width={20} height={20} class="size-5" />
    <input
      id="search-input"
      type="search"
      placeholder={t('search.placeholder')}
      autofocus
      autocomplete="off"
      class="w-full outline-none"
    />
  </header>
  <ul id="search-results" class="flex flex-col gap-8 overflow-auto p-4"></ul>
  <footer
    class="flex items-center justify-between border-t border-line p-4 text-sm text-neutral-600 dark:text-neutral-400"
  >
    <button class="rounded-sm border border-line bg-surface px-2 py-1" command="close" commandfor="search-modal">
      ESC
    </button>
    <span id="search-status">0 {t('search.results')}</span>
  </footer>
</dialog>

<script src="../../scripts/lib/search.ts"></script>
