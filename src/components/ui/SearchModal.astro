---
import SearchIcon from '@components/icons/SearchIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<dialog
  id="search-modal"
  closedby="any"
  data-pagefind-ignore
  class="top-1/2 left-1/2 max-h-[80vh] w-[min(700px,100%)] -translate-1/2 scale-150 flex-col rounded-lg border border-neutral-200 bg-neutral-50 text-neutral-950 opacity-0 transition-[display,overlay,scale,opacity] open:flex open:scale-100 open:opacity-100 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-50 starting:open:scale-150 starting:open:opacity-0"
  aria-label={t('search.modalLabel')}
>
  <header class="flex items-center gap-2 p-4">
    <SearchIcon width={20} height={20} class="size-5" />
    <input
      id="search-input"
      type="search"
      placeholder={t('search.placeholder')}
      autofocus
      autocomplete="off"
      class="w-full outline-none"
    />
  </header>
  <ul id="search-results" class="flex flex-col gap-8 overflow-auto p-4 text-neutral-600 dark:text-neutral-400"></ul>
  <footer
    class="flex items-center justify-between border-t border-neutral-200 p-4 text-sm text-neutral-600 dark:border-neutral-800 dark:text-neutral-400"
  >
    <button
      class="rounded-sm border border-neutral-200 bg-neutral-100 px-2 py-1 dark:border-neutral-800 dark:bg-neutral-900"
      command="close"
      commandfor="search-modal"
    >
      ESC
    </button>
    <span id="search-status">0 {t('search.results')}</span>
  </footer>
</dialog>

<script src="../../scripts/lib/search.ts"></script>
