<script>
  import { copyCode } from '@scripts/utils/copy.ts';

  const COPY_ICON_SVG = `<svg viewBox="0 0 15 15" class="h-6 w-6" fill="currentColor"><path d="M10 4V2.5a.5.5 0 0 0-.5-.5h-7a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .5.5H4V5.5A1.5 1.5 0 0 1 5.5 4zM5.5 5a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .5.5h7a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.5-.5zm7-1A1.5 1.5 0 0 1 14 5.5v7a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 4 12.5V11H2.5A1.5 1.5 0 0 1 1 9.5v-7A1.5 1.5 0 0 1 2.5 1h7A1.5 1.5 0 0 1 11 2.5V4z"/></svg>`;

  const getLabels = () => {
    const lang = document.documentElement.lang || 'en';
    return lang.startsWith('es')
      ? { copy: 'Copiar código', copied: 'Copiado' }
      : { copy: 'Copy code', copied: 'Copied' };
  };

  let abortController: AbortController | null = null;

  const setupCodeBlocks = () => {
    abortController?.abort();
    abortController = new AbortController();

    const labels = getLabels();

    document.querySelectorAll('pre.astro-code').forEach((pre) => {
      if (pre.closest('.code-block-wrapper')) return;

      const parent = pre.parentNode;
      console.log({ parent });
      if (!parent) return;

      const wrapper = document.createElement('div');
      wrapper.className =
        'code-block-wrapper group relative rounded-sm border border-neutral-200 dark:border-neutral-800 overflow-hidden';

      parent.insertBefore(wrapper, pre);
      wrapper.appendChild(pre);

      pre.classList.add('overflow-x-auto', 'p-4', 'font-mono', 'leading-relaxed');

      const popoverId = `copy-popover-${crypto.randomUUID()}`;

      const button = document.createElement('button');
      button.type = 'button';
      button.setAttribute('popovertarget', popoverId);
      button.setAttribute('aria-label', labels.copy);
      button.className =
        'absolute top-4 right-4 flex items-center justify-center rounded-xs border border-neutral-200 dark:border-neutral-800 p-1 opacity-0 transition-[background-color,opacity] duration-300 ease-in-out group-hover:opacity-100';
      button.innerHTML = COPY_ICON_SVG;
      button.addEventListener('click', copyCode, { signal: abortController?.signal });

      const popover = document.createElement('div');
      popover.id = popoverId;
      popover.setAttribute('popover', '');
      popover.className =
        'relative inset-auto mr-4 overflow-visible rounded-sm bg-green-600 px-2 py-1 text-neutral-50 position-area-left after:absolute after:top-1/2 after:left-full after:h-3 after:w-3 after:-translate-x-1.5 after:-translate-y-1/2 after:rotate-45 after:rounded-tr-sm after:bg-green-600';
      popover.textContent = labels.copied;

      wrapper.appendChild(button);
      wrapper.appendChild(popover);
    });
  };

  setupCodeBlocks();
  document.addEventListener('astro:page-load', setupCodeBlocks);
</script>
