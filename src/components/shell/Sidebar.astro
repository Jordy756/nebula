---
import ArrowOutwardIcon from '@components/icons/ArrowOutwardIcon.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import LanguagePicker from '@components/ui/LanguagePicker.astro';
import Logo from '@components/ui/Logo.astro';
import SearchTrigger from '@components/ui/SearchTrigger.astro';
import SidebarItem from '@components/ui/SidebarItem.astro';
import ThemePicker from '@components/ui/ThemePicker.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';
import { getCollection, type CollectionEntry } from 'astro:content';
type Doc = CollectionEntry<'docs'>;

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const currentPath = Astro.url.pathname;

function buildTree(entries: Doc[], locale: string): NavNode[] {
  const levels = new Map<string, NavNode[]>([['', []]]);

  for (const {
    id,
    data: { title },
  } of entries) {
    const slugParts = id.split('/').slice(1);
    const segments = slugParts.slice();
    segments.pop();
    let parentPath = '';

    for (const segment of segments) {
      const path = `${parentPath}/${segment}`;
      if (!levels.has(path)) {
        const items: NavNode[] = [];
        levels.set(path, items);
        levels.get(parentPath)!.push({ title, items });
      }
      parentPath = path;
    }

    const slug = slugParts.join('/');
    levels.get(parentPath)!.push({ title, href: `/${locale}/docs/${slug}` });
  }

  return levels.get('')!;
}

const docs = await getCollection('docs');
const localeDocs = docs.filter((entry) => entry.id.startsWith(`${currentLocale}/`));
const navigation = buildTree(localeDocs, currentLocale);
// console.log(navigation);
---

<aside
  data-pagefind-ignore
  class:list={[
    'sticky top-0 left-0 max-h-screen border-r border-line bg-surface before:absolute before:top-0 before:right-full before:h-full before:w-screen before:bg-surface',
    className,
  ]}
>
  <div class="ml-auto flex h-full w-[min(100%,300px)] flex-col">
    <header
      class="relative flex flex-col gap-4 p-4 after:absolute after:top-full after:left-0 after:z-10 after:h-4 after:w-full after:bg-linear-to-b after:from-surface after:to-transparent"
    >
      <h2 class="sr-only">{t('nav.sidebar')}</h2>
      <a href={`/${currentLocale}/`} aria-label={t('nav.home')}>
        <Logo width={100} height={24} />
      </a>
      <SearchTrigger />
    </header>
    <nav class="w-full flex-1 scrollbar-none overflow-y-auto p-4" aria-label={t('nav.main')}>
      <ul class="flex flex-col gap-2">
        {navigation.map((node) => <SidebarItem node={node} currentPath={currentPath} />)}
        {navigation.map((node) => <SidebarItem node={node} currentPath={currentPath} />)}
        {navigation.map((node) => <SidebarItem node={node} currentPath={currentPath} />)}
      </ul>
    </nav>
    <footer
      class="relative p-4 after:absolute after:bottom-full after:left-0 after:h-4 after:w-full after:bg-linear-to-t after:from-surface after:to-transparent"
    >
      <div class="flex items-center gap-4 justify-between">
        <div class="flex items-center gap-2">
          <GithubIcon width={16} height={16} class="size-6" />
          <GithubIcon width={16} height={16} class="size-6" />
        </div>
        
        <section class="flex items-center justify-between gap-2">
          <ThemePicker />
          <LanguagePicker />
        </section>
        <!-- <a
          href="https://github.com/withastro/astro"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="group text-muted-foreground flex items-center gap-2 rounded-sm px-2 py-1.5 text-base transition-colors hover:bg-line hover:text-foreground"
        >
          <GithubIcon width={16} height={16} class="size-4" />
          <span class="flex-1">{t('footer.github')}</span>
          <ArrowOutwardIcon
            width={16}
            height={16}
            class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a> -->
      </div>
    </footer>
  </div>
</aside>
