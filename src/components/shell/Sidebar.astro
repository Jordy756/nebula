---
import ArrowOutwardIcon from '@components/icons/ArrowOutwardIcon.astro';
import GithubIcon from '@components/icons/GithubIcon.astro';
import PanelIcon from '@components/icons/PanelIcon.astro';
import LanguagePicker from '@components/ui/LanguagePicker.astro';
import Logo from '@components/ui/Logo.astro';
import SearchTrigger from '@components/ui/SearchTrigger.astro';
import SidebarItem from '@components/ui/SidebarItem.astro';
import ThemePicker from '@components/ui/ThemePicker.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';
import { getCollection, type CollectionEntry } from 'astro:content';
type Doc = CollectionEntry<'docs'>;

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const currentPath = Astro.url.pathname;

function buildTree(entries: Doc[], locale: string): NavNode[] {
  const levels = new Map<string, NavNode[]>([['', []]]);

  for (const {
    id,
    data: { title },
  } of entries) {
    const slugParts = id.split('/').slice(1);
    const segments = slugParts.slice();
    segments.pop();
    let parentPath = '';

    for (const segment of segments) {
      const path = `${parentPath}/${segment}`;
      if (!levels.has(path)) {
        const items: NavNode[] = [];
        levels.set(path, items);
        levels.get(parentPath)!.push({ title, items });
      }
      parentPath = path;
    }

    const slug = slugParts.join('/');
    levels.get(parentPath)!.push({ title, href: `/${locale}/docs/${slug}` });
  }

  return levels.get('')!;
}

const docs = await getCollection('docs');
const localeDocs = docs.filter((entry) => entry.id.startsWith(`${currentLocale}/`));
const navigation = buildTree(localeDocs, currentLocale);
// console.log(navigation);

const socialLinks = [{ href: 'https://nebula-drab-five.vercel.app/', title: t('nav.nebula') }];
---

<aside
  data-pagefind-ignore
  class:list={[
    'sticky top-0 left-0 z-50 max-h-screen lg:border-r border-line bg-surface xl:before:absolute xl:before:top-0 xl:before:right-full xl:before:h-full xl:before:w-screen xl:before:bg-surface max-lg:border-b',
    className,
  ]}
>
  <div class="flex h-full w-[min(65ch,100%)] flex-col max-lg:mx-auto lg:w-[min(100%,300px)] xl:ml-auto">
    <header
      class="relative flex gap-4 p-4 max-lg:items-center lg:flex-col lg:after:absolute lg:after:top-full lg:after:left-0 lg:after:h-4 lg:after:w-full lg:after:bg-linear-to-b lg:after:from-surface lg:after:to-transparent"
    >
      <h2 class="sr-only">{t('nav.sidebar')}</h2>
      <a href={`/${currentLocale}/`} aria-label={t('nav.home')} class="mr-auto">
        <Logo width={100} height={24} />
      </a>
      <SearchTrigger />
      <button popovertarget="sidebar-open" class="lg:hidden">
        <PanelIcon width={24} class="size-6" />
      </button>
    </header>
    <nav class="w-full flex-1 scrollbar-none overflow-y-auto p-4 max-lg:hidden" aria-label={t('nav.main')}>
      <ul class="flex flex-col gap-2">
        {navigation.map((node) => <SidebarItem node={node} currentPath={currentPath} />)}
      </ul>
    </nav>
    <footer
      class="relative p-4 after:absolute after:bottom-full after:left-0 after:h-4 after:w-full after:bg-linear-to-t after:from-surface after:to-transparent max-lg:hidden"
    >
      <div class="flex flex-col gap-2 rounded-sm border border-line p-2">
        <div class="flex items-center justify-between gap-4">
          <a
            href="https://github.com/withastro/astro"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('nav.github.ariaLabel')}
            title={t('nav.github.ariaLabel')}
            class="transition-opacity hover:opacity-75"
          >
            <GithubIcon width={22} class="size-5.5" />
          </a>
          <div class="flex items-center gap-1">
            <LanguagePicker />
            <ThemePicker />
          </div>
        </div>
        <hr class="border-line" />
        <nav>
          <ul class="flex flex-col gap-2">
            {
              socialLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 transition-opacity hover:opacity-75"
                  >
                    <span class="flex-1">{item.title}</span>
                    <ArrowOutwardIcon width={20} class="size-5 rotate-45 transition-[rotate] group-hover:rotate-0" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </footer>
  </div>
  <div
    id="sidebar-open"
    class="inset-auto bg-surface right-0 h-dvh w-[min(350px,80%)] translate-x-full flex-col overlay-backdrop transition-[translate,overlay,display] transition-discrete duration-350 ease-out will-change-[translate] open:flex open:translate-x-0 starting:open:translate-x-full"
    popover
  >
    <header
      class="relative flex p-4 after:absolute after:top-full after:left-0 after:h-4 after:w-full after:bg-linear-to-b after:from-surface after:to-transparent"
    >
      <h2 class="sr-only">{t('nav.sidebar')}</h2>
      <a href={`/${currentLocale}/`} aria-label={t('nav.home')}>
        <Logo width={100} height={24} />
      </a>
    </header>
    <nav class="max-hidden w-full flex-1 scrollbar-none overflow-y-auto p-4" aria-label={t('nav.main')}>
      <ul class="flex flex-col gap-2">
        {navigation.map((node) => <SidebarItem node={node} currentPath={currentPath} />)}
      </ul>
    </nav>
    <footer
      class="relative p-4 after:absolute after:bottom-full after:left-0 after:h-4 after:w-full after:bg-linear-to-t after:from-surface after:to-transparent"
    >
      <div class="flex flex-col gap-2 rounded-sm border border-line p-2">
        <div class="flex items-center justify-between gap-4">
          <a
            href="https://github.com/withastro/astro"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('nav.github.ariaLabel')}
            title={t('nav.github.ariaLabel')}
            class="transition-opacity hover:opacity-75"
          >
            <GithubIcon width={22} class="size-5.5" />
          </a>
          <div class="flex items-center gap-1">
            <LanguagePicker />
            <ThemePicker />
          </div>
        </div>
        <hr class="border-line" />
        <nav>
          <ul class="flex flex-col gap-2">
            {
              socialLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 transition-opacity hover:opacity-75"
                  >
                    <span class="flex-1">{item.title}</span>
                    <ArrowOutwardIcon width={20} class="size-5 rotate-45 transition-[rotate] group-hover:rotate-0" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </footer>
  </div>
</aside>
