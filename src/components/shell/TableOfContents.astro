---
import TocIcon from '@components/icons/TocIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const filteredHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const getLineX = (depth: number) => (depth >= 3 ? 16.5 : 8.5);

const links = filteredHeadings.map(({ slug, text, depth }, index) => {
  const prevDepth = index > 0 ? filteredHeadings[index - 1].depth : depth;
  const hasTransition = depth !== prevDepth;
  const x = getLineX(depth);
  const prevX = getLineX(prevDepth);

  return { slug, text, depth, index, x, prevX, hasTransition };
});
---

<aside data-pagefind-ignore class="sticky top-0 left-0 flex max-h-screen flex-1 flex-col overflow-y-auto py-12 pr-4">
  <nav class="flex flex-col gap-2" aria-label="Tabla de contenidos">
    <div class="flex items-center gap-2">
      <TocIcon width={24} height={24} class="size-6" />
      <h3 class="text-base font-semibold">{t('toc.title')}</h3>
    </div>
    <ul class="relative flex flex-col">
      {
        links.map(({ slug, text, depth, index, x, prevX, hasTransition }) => (
          <li class="relative flex py-1.5 text-sm first:pt-0">
            <a
              href={`#${slug}`}
              class:list={[
                'group text-neutral-600 transition-[color] duration-300 ease-in-out hover:text-neutral-800 data-[active=true]:text-vivid-crimson dark:text-neutral-400 dark:hover:text-neutral-200',
                depth === 2 ? 'ms-5' : 'ms-8',
              ]}
              data-toc-link
              data-heading-slug={slug}
              data-toc-index={index}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="absolute inset-s-0 -top-1.5 -z-1 h-full overflow-visible rtl:-scale-x-100"
              >
                {hasTransition ? (
                  <>
                    <path
                      d={`M ${prevX} 0 C ${prevX} 8 ${x} 4 ${x} 12`}
                      stroke-width="1"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="stroke-neutral-200 transition-colors duration-300 group-data-[active=true]:stroke-vivid-crimson dark:stroke-neutral-800"
                    />
                    <line
                      x1={x}
                      y1="12"
                      x2={x}
                      y2="100%"
                      stroke-width="1"
                      class="stroke-neutral-200 transition-colors duration-300 group-data-[active=true]:stroke-vivid-crimson dark:stroke-neutral-800"
                    />
                  </>
                ) : (
                  <line
                    x1={x}
                    y1="0"
                    x2={x}
                    y2="100%"
                    stroke-width="1"
                    class="stroke-neutral-200 transition-colors duration-300 group-data-[active=true]:stroke-vivid-crimson dark:stroke-neutral-800"
                  />
                )}
                <circle
                  cx={prevX}
                  cy="0"
                  r="2"
                  class="fill-vivid-crimson opacity-0 transition-opacity duration-300 group-data-[active-edge=top]:opacity-100"
                />
                <circle
                  cx={x}
                  cy="100%"
                  r="2"
                  class="fill-vivid-crimson opacity-0 transition-opacity duration-300 group-data-[active-edge=bottom]:opacity-100"
                />
              </svg>
              {text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</aside>

<script src="../../scripts/lib/toc.ts"></script>
