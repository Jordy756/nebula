---
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
}
const { src, alt, class: className, ...rest } = Astro.props;
---

<figure>
  <Image src={src} alt={alt} width={644} height={362} class:list={['h-auto w-full rounded-sm', className]} {...rest} />
  <figcaption class="sr-only">{alt}</figcaption>
</figure>
