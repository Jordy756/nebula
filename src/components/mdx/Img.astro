---
import { Image } from 'astro:assets';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
  width?: number;
  height?: number;
}
const { src, alt, class: className, width = 644, height = 362, ...rest } = Astro.props;
---

<figure>
  <Image
    src={src}
    alt="A description of my image."
    layout="constrained"
    width={width}
    height={height}
    class:list={['h-auto w-full rounded-sm', className]}
    {...rest}
  />
  <figcaption class="sr-only">{alt}</figcaption>
</figure>
