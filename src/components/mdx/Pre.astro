---
import CopyIcon from '@components/icons/CopyIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

const popoverId = `copy-popover-${crypto.randomUUID()}`;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<figure
  class="astro-code group relative overflow-hidden rounded-sm border border-neutral-200 bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900"
>
  <pre class="overflow-x-auto p-4 leading-relaxed"><slot /></pre>
  <button
    popovertarget={popoverId}
    aria-label={t('code.copy')}
    class="absolute top-4 right-4 flex items-center justify-center rounded-xs border border-neutral-200 p-1 opacity-0 transition-[background-color,opacity] duration-300 ease-in-out group-hover:opacity-100 dark:border-neutral-800"
  >
    <CopyIcon width={24} height={24} class="size-6" />
  </button>
  <div
    id={popoverId}
    class="relative inset-auto mr-4 overflow-visible rounded-sm bg-green-600 px-2 py-1 text-neutral-50 position-area-left after:absolute after:top-1/2 after:left-full after:h-3 after:w-3 after:-translate-x-1.5 after:-translate-y-1/2 after:rotate-45 after:rounded-tr-sm after:bg-green-600"
    popover
  >
    {t('code.copied')}
  </div>
</figure>

<script>
  import { copyCode } from '@scripts/utils/copy.ts';

  const attach = () => {
    document
      .querySelectorAll<HTMLButtonElement>('button[popovertarget^="copy-popover-"]')
      .forEach((button) => button.addEventListener('click', copyCode));
  };

  document.addEventListener('astro:page-load', attach);
</script>
