---
import CopyIcon from '@components/icons/CopyIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

const popoverId = `copy-popover-${crypto.randomUUID()}`;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<figure class="astro-code group relative w-full overflow-hidden rounded-sm border border-line bg-surface">
  <pre class="overflow-x-auto p-4 leading-relaxed"><slot /></pre>
  <button
    popovertarget={popoverId}
    aria-label={t('code.copy')}
    class="absolute top-4 right-4 flex items-center justify-center rounded-xs border border-line bg-background p-1 opacity-0 transition-[background-color,opacity] duration-300 ease-in-out group-hover:opacity-100 focus:opacity-100"
  >
    <CopyIcon width={24} height={24} class="size-6" />
  </button>
  <!-- translate-x-full flex-col overlay-backdrop transition-[translate,overlay,display] transition-discrete duration-350 ease-out will-change-[translate] open:flex open:translate-x-0 starting:open:translate-x-full -->
  <div
    id={popoverId}
    class="relative inset-auto mr-4 overflow-visible rounded-sm bg-green-600 px-2 py-1 text-neutral-50 opacity-0 transition-[opacity,overlay,display] transition-discrete duration-350 ease-out position-area-left after:absolute after:top-1/2 after:left-full after:h-3 after:w-3 after:-translate-x-1.5 after:-translate-y-1/2 after:rotate-45 after:rounded-tr-sm after:bg-green-600 open:opacity-100 starting:open:opacity-0"
    popover="auto"
  >
    {t('code.copied')}
  </div>
</figure>

<script>
  import { copyCode } from '@scripts/utils/copy.ts';

  const attach = () => {
    document
      .querySelectorAll<HTMLButtonElement>('button[popovertarget^="copy-popover-"]')
      .forEach((button) => button.addEventListener('click', copyCode));
  };

  document.addEventListener('astro:page-load', attach);
</script>
