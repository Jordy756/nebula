---
import Copy from '@components/icons/Copy.astro';

const popoverId = `copy-popover-${crypto.randomUUID()}`;
---

<div class="group relative mb-4 rounded-sm border border-neutral-800 bg-neutral-900">
  <pre class="overflow-x-auto p-4 font-sans leading-relaxed font-normal"><slot /></pre>
  <button
    popovertarget={popoverId}
    class="absolute top-4 right-4 flex items-center justify-center rounded-xs border border-neutral-800 p-1 opacity-0 transition-[background-color,opacity] duration-300 ease-in-out group-hover:opacity-100"
  >
    <Copy width={24} height={24} class="h-6 w-6" />
  </button>
  <div class="inset-auto mr-4 bg-green-600 px-1 py-0.5 text-neutral-50 [position-area:left]" popover id={popoverId}>
    Copiado
  </div>
</div>

<script>
  import { copyCode } from '@scripts/utils/copy.ts';

  document
    .querySelectorAll<HTMLButtonElement>('button[popovertarget^="copy-popover-"]')
    .forEach((button) => button.addEventListener('click', copyCode));
</script>
