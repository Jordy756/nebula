---
import CopyIcon from '@components/icons/CopyIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

const popoverId = `copy-popover-${crypto.randomUUID()}`;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<figure class="astro-code group relative w-full overflow-hidden rounded-sm border border-line bg-surface">
  <pre class="overflow-x-auto p-4 leading-relaxed"><slot /></pre>
  <button
    popovertarget={popoverId}
    data-copy-code
    aria-label={t('code.copy')}
    class="absolute top-4 right-4 flex items-center justify-center rounded-xs border border-line bg-surface p-1 opacity-0 transition-[background-color,opacity] duration-300 ease-in-out max-lg:opacity-100 lg:group-hover:opacity-100 lg:focus:opacity-100"
  >
    <CopyIcon width={24} height={24} class="size-6" />
  </button>
  <div
    id={popoverId}
    class="relative inset-auto mr-4 overflow-visible rounded-sm bg-green-600 px-2 py-1 text-neutral-50 opacity-0 transition-[opacity,overlay,display] transition-discrete duration-350 ease-out position-area-left after:absolute after:top-1/2 after:left-full after:h-3 after:w-3 after:-translate-x-1.5 after:-translate-y-1/2 after:rotate-45 after:rounded-tr-sm after:bg-green-600 open:opacity-100 starting:open:opacity-0"
    popover="auto"
  >
    {t('code.copied')}
  </div>
</figure>

<script>
  const timeouts = new WeakMap<HTMLButtonElement, ReturnType<typeof setTimeout>>();

  document.addEventListener('click', async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-copy-code]');
    if (!button) return;

    const pre = button.closest<HTMLElement>('.astro-code')?.querySelector<HTMLPreElement>('pre');
    if (!pre) return;

    try {
      await navigator.clipboard.writeText(pre.textContent ?? '');
    } catch {
      return;
    }

    const popoverId = button.getAttribute('popovertarget');
    const popover = popoverId ? document.getElementById(popoverId) : null;
    if (!popover) return;

    clearTimeout(timeouts.get(button));
    timeouts.set(
      button,
      setTimeout(() => popover.matches(':popover-open') && popover.hidePopover(), 1000),
    );
  });
</script>
