---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'iframe'> {
  src: string;
  title?: string;
}

const { src, title = 'Video incrustado de plataforma externa', class: className, ...rest } = Astro.props;

const match = src.match(/^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/);
const videoId = match && match[2].length === 11 ? match[2] : null;
const youtubeSrc = videoId ? `https://www.youtube-nocookie.com/embed/${videoId}` : src;
---

<div class:list={['flex aspect-video h-auto w-full overflow-hidden rounded-sm', className]}>
  <iframe
    src={youtubeSrc}
    title={title}
    class="h-full w-full"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    loading="lazy"
    {...rest}
  >
  </iframe>
</div>
