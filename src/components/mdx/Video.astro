---
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'video'> {
  src: string;
}

const { src, class: className, controls = true, playsinline = false, preload = 'metadata', ...rest } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<video
  controls={controls}
  playsinline={playsinline}
  preload={preload}
  class:list={['aspect-video h-auto w-full rounded-sm bg-surface', className]}
  {...rest}
>
  <source src={src} type={`video/${src.split('.').pop()}`} />
  {t('video.fallback')}
</video>
