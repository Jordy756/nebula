---
import PanelIcon from '@shared/components/icons/PanelIcon.astro';
import Logo from '@shared/components/ui/Logo.astro';
import { getCurrentLocale, useTranslations } from '@shared/i18n/utils.ts';
import { getCollection } from 'astro:content';
import { buildSidebar } from '@features/docs/scripts/lib/sidebar.ts';
import SearchTrigger from '@features/docs/components/ui/SearchTrigger.astro';
import SidebarBody from './SidebarBody.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const currentPath = Astro.url.pathname;

const docs = await getCollection('docs');
const sidebar = buildSidebar(docs, currentLocale);
---

<aside
  data-pagefind-ignore
  class:list={[
    'sticky top-0 left-0 z-50 max-h-screen border-line bg-surface max-lg:border-b lg:border-r xl:before:absolute xl:before:top-0 xl:before:right-full xl:before:h-full xl:before:w-screen xl:before:bg-surface',
    className,
  ]}
>
  <div class="flex h-full w-[min(65ch,100%)] flex-col max-lg:mx-auto lg:w-[min(100%,300px)] xl:ml-auto">
    <header
      class="relative flex gap-4 p-4 max-lg:items-center lg:flex-col lg:after:absolute lg:after:top-full lg:after:left-0 lg:after:h-4 lg:after:w-full lg:after:bg-linear-to-b lg:after:from-surface lg:after:to-transparent"
    >
      <h2 class="sr-only">{t('nav.sidebar')}</h2>
      <a href={`/${currentLocale}/`} aria-label={t('nav.home')} class="mr-auto">
        <Logo width={100} height={24} />
      </a>
      <SearchTrigger />
      <button popovertarget="sidebar-open" class="lg:hidden">
        <PanelIcon width={24} class="size-6" />
      </button>
    </header>
    <SidebarBody navigation={sidebar} currentPath={currentPath} currentLocale={currentLocale} />
  </div>
  <div
    id="sidebar-open"
    class="inset-[unset] top-0 right-0 h-dvh w-[min(350px,80%)] translate-x-full flex-col overlay-backdrop bg-surface transition-[translate,overlay,display] transition-discrete duration-350 ease-out will-change-[translate] open:flex open:translate-x-0 starting:open:translate-x-full"
    popover
  >
    <header
      class="relative flex p-4 after:absolute after:top-full after:left-0 after:h-4 after:w-full after:bg-linear-to-b after:from-surface after:to-transparent"
    >
      <h2 class="sr-only">{t('nav.sidebar')}</h2>
      <a href={`/${currentLocale}/`} aria-label={t('nav.home')}>
        <Logo width={100} height={24} />
      </a>
    </header>
    <SidebarBody navigation={sidebar} currentPath={currentPath} currentLocale={currentLocale} isMenu />
  </div>
</aside>
