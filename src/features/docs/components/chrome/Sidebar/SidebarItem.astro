---
import ChevronIcon from '@shared/components/icons/ChevronIcon.astro';
import type { NavNode } from '@features/docs/scripts/lib/sidebar.ts';

interface Props {
  node: NavNode;
  currentPath: string;
}

const { node, currentPath } = Astro.props;
const isGroup = 'items' in node;

const isCurrent = (href: string): boolean => currentPath === href || currentPath === `${href}/`;

const isCurrentItem = !isGroup && isCurrent(node.href);
const isOpen = isGroup && node.items.some((item) => isCurrent(item.href));
---

{
  isGroup ? (
    <li>
      <details
        open={isOpen}
        class="group details-content:h-0 details-content:overflow-y-clip details-content:[transition:content-visibility_500ms_allow-discrete,height_500ms] open:details-content:h-auto"
      >
        <summary class="group flex cursor-pointer items-center justify-between gap-2 text-sm">
          <span class="font-medium">{node.title}</span>
          <ChevronIcon width={16} height={16} class="size-4 transition-transform duration-300 group-open:rotate-180" />
        </summary>
        <div class="flex gap-3 transition-[margin] duration-500 group-open:mt-2">
          <div class="ml-2 w-px bg-line" />
          <ul class="flex flex-1 flex-col gap-2">
            {node.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                  class:list={[
                    'block rounded-xs text-sm transition-colors',
                    isCurrent(item.href) ? 'font-medium text-primary' : '',
                  ]}
                >
                  {item.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </details>
    </li>
  ) : (
    <li>
      <a
        href={node.href}
        aria-current={isCurrentItem ? 'page' : undefined}
        class:list={['block rounded-xs text-sm transition-colors', isCurrentItem ? 'font-medium text-primary' : '']}
      >
        {node.title}
      </a>
    </li>
  )
}
