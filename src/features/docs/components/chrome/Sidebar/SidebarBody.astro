---
import ArrowOutwardIcon from '@shared/components/icons/ArrowOutwardIcon.astro';
import GithubIcon from '@shared/components/icons/GithubIcon.astro';
import LanguagePicker from '@shared/components/ui/LanguagePicker.astro';
import ThemePicker from '@shared/components/ui/ThemePicker.astro';
import { useTranslations, type Locale } from '@shared/i18n/utils.ts';
import type { NavNode } from '@features/docs/scripts/lib/sidebar.ts';
import SidebarItem from './SidebarItem.astro';

interface Props {
  navigation: NavNode[];
  currentPath: string;
  currentLocale: Locale;
  isMenu?: boolean;
}

const { navigation, currentPath, currentLocale, isMenu = false } = Astro.props;
const t = useTranslations(currentLocale);

const socialLinks = [{ href: 'https://nebula-drab-five.vercel.app/', title: t('nav.nebula') }];
---

<nav class="w-full flex-1 scrollbar-none overflow-y-auto p-4 max-lg:hidden" aria-label={t('nav.main')}>
  <ul class="flex flex-col gap-2">
    {navigation.map((node) => <SidebarItem node={node} currentPath={currentPath} />)}
  </ul>
</nav>
<footer
  class="relative p-4 after:absolute after:bottom-full after:left-0 after:h-4 after:w-full after:bg-linear-to-t after:from-surface after:to-transparent max-lg:hidden"
>
  <div class="flex flex-col gap-2 rounded-sm border border-line p-2">
    <div class="flex items-center justify-between gap-4">
      <a
        href="https://github.com/withastro/astro"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t('nav.github.ariaLabel')}
        title={t('nav.github.ariaLabel')}
        class="transition-opacity hover:opacity-75"
      >
        <GithubIcon width={22} class="size-5.5" />
      </a>
      <div class="flex items-center gap-1">
        <LanguagePicker />
        <ThemePicker />
      </div>
    </div>
    <hr class="border-line" />
    <nav>
      <ul class="flex flex-col gap-2">
        {
          socialLinks.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-2 transition-opacity hover:opacity-75"
              >
                <span class="flex-1">{item.title}</span>
                <ArrowOutwardIcon width={20} class="size-5 rotate-45 transition-[rotate] group-hover:rotate-0" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
