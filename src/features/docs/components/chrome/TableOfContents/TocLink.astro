---
interface Props {
  link: {
    slug: string;
    text: string;
    depth: number;
    index: number;
    x: number;
    prevX: number;
    hasTransition: boolean;
  };
}

const { link } = Astro.props;
const { slug, text, depth, index, x, prevX, hasTransition } = link;
---

<li class="relative flex py-1.5 text-sm first:pt-0">
  <a
    href={`#${slug}`}
    class:list={[
      'group text-neutral-600 transition-[color,opacity] duration-300 ease-in-out hover:opacity-75 data-[active=true]:text-primary dark:text-neutral-400',
      depth === 2 ? 'ms-5' : 'ms-8',
    ]}
    data-toc-link
    data-heading-slug={slug}
    data-toc-index={index}
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="absolute inset-s-0 -top-1.5 -z-1 h-full overflow-visible rtl:-scale-x-100"
    >
      {
        hasTransition ? (
          <>
            <path
              d={`M ${prevX} 0 C ${prevX} 8 ${x} 4 ${x} 12`}
              stroke-width="1"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
            />
            <line
              x1={x}
              y1="12"
              x2={x}
              y2="100%"
              stroke-width="1"
              class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
            />
          </>
        ) : (
          <line
            x1={x}
            y1="0"
            x2={x}
            y2="100%"
            stroke-width="1"
            class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
          />
        )
      }
      <circle
        cx={prevX}
        cy="0"
        r="2"
        class="fill-primary opacity-0 transition-opacity duration-300 group-data-[active-edge=top]:opacity-100"
      ></circle>
      <circle
        cx={x}
        cy="100%"
        r="2"
        class="fill-primary opacity-0 transition-opacity duration-300 group-data-[active-edge=bottom]:opacity-100"
      ></circle>
    </svg>
    {text}
  </a>
</li>
