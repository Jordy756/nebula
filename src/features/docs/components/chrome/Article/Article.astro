---
import { getCurrentLocale, useTranslations } from '@shared/i18n/utils.ts';
import PageNavLink from './PageNavLink.astro';

interface PageLink {
  href: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  description: string;
  prev?: PageLink;
  next?: PageLink;
}

const { title, description, prev, next } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<article data-pagefind-body class="flex w-full max-w-[65ch] flex-col gap-4 px-4 py-12">
  <header class="flex flex-col gap-4 border-b border-line">
    <h1 data-pagefind-meta="title">{title}</h1>
    <p data-pagefind-meta="description" class="mb-12">{description}</p>
  </header>
  <div class="markdown-body flex flex-1 flex-col gap-4">
    <slot />
  </div>
  <footer class="mt-12 flex flex-col gap-4 sm:flex-row">
    {prev && <PageNavLink dir="prev" href={prev.href} title={prev.title} description={prev.description} />}
    {next && <PageNavLink dir="next" href={next.href} title={next.title} description={next.description} />}
  </footer>
</article>
