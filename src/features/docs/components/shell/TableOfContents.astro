---
import ChevronIcon from '@shared/components/icons/ChevronIcon.astro';
import TocIcon from '@shared/components/icons/TocIcon.astro';
import { getCurrentLocale, useTranslations } from '@shared/i18n/utils.ts';
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings = [] } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const filteredHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const getLineX = (depth: number) => (depth >= 3 ? 16.5 : 8.5);

const links = filteredHeadings.map(({ slug, text, depth }, index) => {
  const prevDepth = index > 0 ? filteredHeadings[index - 1].depth : depth;
  const hasTransition = depth !== prevDepth;
  const x = getLineX(depth);
  const prevX = getLineX(prevDepth);

  return { slug, text, depth, index, x, prevX, hasTransition };
});
---

<aside
  data-pagefind-ignore
  class="sticky top-14.25 left-0 z-50 flex max-h-screen scrollbar-none flex-col overflow-y-auto border-b border-line bg-background area-toc lg:top-0 xl:py-12"
>
  <nav class="mx-auto flex w-[min(65ch,100%)] flex-col gap-2 p-4 max-xl:items-start lg:p-4 lg:pl-0 xl:py-0">
    <div class="flex items-center gap-2 max-xl:hidden">
      <TocIcon width={24} height={24} class="size-6" />
      <h3 class="text-base font-semibold">{t('docs.toc.title')}</h3>
    </div>
    <button class="flex w-full items-center gap-2 xl:hidden" popovertarget="toc-popover">
      <TocIcon width={24} height={24} class="size-6" />
      <h3 class="text-base font-semibold">{t('docs.toc.title')}</h3>
      <ChevronIcon
        width={20}
        class="ml-auto size-5 -rotate-90 transition-[rotate] xl:hidden [aside:has(#toc-popover:popover-open)_&]:rotate-0"
      />
    </button>
    <ul class="relative hidden flex-col xl:flex">
      {
        links.map(({ slug, text, depth, index, x, prevX, hasTransition }) => (
          <li class="relative flex py-1.5 text-sm first:pt-0">
            <a
              href={`#${slug}`}
              class:list={[
                'group text-neutral-600 transition-[color,opacity] duration-300 ease-in-out hover:opacity-75 data-[active=true]:text-primary dark:text-neutral-400',
                depth === 2 ? 'ms-5' : 'ms-8',
              ]}
              data-toc-link
              data-heading-slug={slug}
              data-toc-index={index}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="absolute inset-s-0 -top-1.5 -z-1 h-full overflow-visible rtl:-scale-x-100"
              >
                {hasTransition ? (
                  <>
                    <path
                      d={`M ${prevX} 0 C ${prevX} 8 ${x} 4 ${x} 12`}
                      stroke-width="1"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
                    />
                    <line
                      x1={x}
                      y1="12"
                      x2={x}
                      y2="100%"
                      stroke-width="1"
                      class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
                    />
                  </>
                ) : (
                  <line
                    x1={x}
                    y1="0"
                    x2={x}
                    y2="100%"
                    stroke-width="1"
                    class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
                  />
                )}
                <circle
                  cx={prevX}
                  cy="0"
                  r="2"
                  class="fill-primary opacity-0 transition-opacity duration-300 group-data-[active-edge=top]:opacity-100"
                />
                <circle
                  cx={x}
                  cy="100%"
                  r="2"
                  class="fill-primary opacity-0 transition-opacity duration-300 group-data-[active-edge=bottom]:opacity-100"
                />
              </svg>
              {text}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div
    id="toc-popover"
    class="inset-auto top-[anchor(bottom)] left-[anchor(left)] mt-2 mr-4 max-h-[60vh] w-[calc(min(65ch,100%)-32px)] overflow-x-hidden rounded-sm border border-line bg-surface p-4 transition-[clip-path,overlay,display] transition-discrete duration-350 ease-out [clip-path:inset(0_0_100%_0)] open:[clip-path:inset(0_0_0_0)] starting:open:[clip-path:inset(0_0_100%_0)]"
    popover
  >
    <ul class="relative flex flex-col">
      {
        links.map(({ slug, text, depth, index, x, prevX, hasTransition }) => (
          <li class="relative flex py-1.5 text-sm first:pt-0">
            <a
              href={`#${slug}`}
              class:list={[
                'group text-neutral-600 transition-[color,opacity] duration-300 ease-in-out hover:opacity-75 data-[active=true]:text-primary dark:text-neutral-400',
                depth === 2 ? 'ms-5' : 'ms-8',
              ]}
              data-toc-link
              data-heading-slug={slug}
              data-toc-index={index}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="absolute inset-s-0 -top-1.5 -z-1 h-full overflow-visible rtl:-scale-x-100"
              >
                {hasTransition ? (
                  <>
                    <path
                      d={`M ${prevX} 0 C ${prevX} 8 ${x} 4 ${x} 12`}
                      stroke-width="1"
                      fill="none"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
                    />
                    <line
                      x1={x}
                      y1="12"
                      x2={x}
                      y2="100%"
                      stroke-width="1"
                      class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
                    />
                  </>
                ) : (
                  <line
                    x1={x}
                    y1="0"
                    x2={x}
                    y2="100%"
                    stroke-width="1"
                    class="stroke-line transition-colors duration-300 group-data-[active=true]:stroke-primary"
                  />
                )}
                <circle
                  cx={prevX}
                  cy="0"
                  r="2"
                  class="fill-primary opacity-0 transition-opacity duration-300 group-data-[active-edge=top]:opacity-100"
                />
                <circle
                  cx={x}
                  cy="100%"
                  r="2"
                  class="fill-primary opacity-0 transition-opacity duration-300 group-data-[active-edge=bottom]:opacity-100"
                />
              </svg>
              {text}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<script src="./toc.ts"></script>
