---
import SearchIcon from '@components/icons/SearchIcon.astro';
import { getCurrentLocale, useTranslations } from '@i18n/utils.ts';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<button
  command="show-modal"
  commandfor="search-modal"
  data-search-open
  aria-label={t('search.open')}
  class:list={[
    'flex items-center gap-2 rounded-sm lg:border lg:border-line lg:p-2 lg:text-neutral-600 lg:dark:text-neutral-400',
    className,
  ]}
>
  <SearchIcon width={24} height={24} class="size-6 lg:size-5" />
  <span class="flex-1 truncate text-left max-lg:hidden">{t('search.open')}</span>
  <kbd class="hidden items-center rounded-sm bg-neutral-200 px-1.5 py-0.5 text-xs lg:inline-flex dark:bg-neutral-800"
    >{t('search.shortcut')}</kbd
  >
</button>
