---
import ChevronIcon from '@shared/components/icons/ChevronIcon.astro';
import { getCurrentLocale, useTranslations } from '@shared/i18n/utils.ts';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

interface PageLink {
  href: string;
  title: string;
}

interface AstroProps extends Props {
  prev?: PageLink;
  next?: PageLink;
}

const { post, prev, next } = Astro.props as AstroProps;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);

const formatDate = (date: Date, locale: string): string => {
  return new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);
};
---

<article class="flex w-full max-w-[65ch] flex-col gap-6 px-4 py-12">
  <header class="flex flex-col gap-4 border-b border-line pb-6">
    <h1>{post.data.title}</h1>
    <div class="flex items-center gap-2 text-sm text-neutral-600 dark:text-neutral-400">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDate(post.data.pubDate, currentLocale)}
      </time>
      {
        post.data.author && (
          <>
            <span aria-hidden="true">·</span>
            <span>{post.data.author}</span>
          </>
        )
      }
    </div>
    {
      post.data.tags && (
        <ul class="flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <li class="rounded-sm border border-line bg-line/50 px-2 py-0.5 text-xs">#{tag}</li>
          ))}
        </ul>
      )
    }
  </header>
  <div class="markdown-body flex flex-1 flex-col gap-4">
    <slot />
  </div>
  <footer class="mt-12 flex flex-col gap-4 border-t border-line pt-6 sm:flex-row">
    {
      prev && (
        <a
          href={prev.href}
          class="flex flex-1 flex-col gap-2 overflow-hidden rounded-sm border border-line p-4 transition-[border-color] hover:border-neutral-300 dark:hover:border-neutral-700"
          rel="prev"
        >
          <span class="sr-only">{t('article.prev')}</span>
          <div class="flex items-center gap-2 font-semibold">
            <ChevronIcon class="size-5 rotate-90" aria-hidden="true" />
            <span>{prev.title}</span>
          </div>
        </a>
      )
    }
    {
      next && (
        <a
          href={next.href}
          class="flex flex-1 flex-col gap-2 overflow-hidden rounded-sm border border-line p-4 transition-[border-color] hover:border-neutral-300 dark:hover:border-neutral-700"
          rel="next"
        >
          <span class="sr-only">{t('article.next')}</span>
          <div class="flex items-center gap-2 self-end font-semibold">
            <span>{next.title}</span>
            <ChevronIcon class="size-5 -rotate-90" aria-hidden="true" />
          </div>
        </a>
      )
    }
  </footer>
</article>