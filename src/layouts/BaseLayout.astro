---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = 'Nebula', description = 'Documentation built with Nebula' } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-neutral-950 text-pretty text-neutral-50">
    <div id="root" class="min-h-vh relative flex flex-col items-center overflow-clip">
      <slot />
    </div>
  </body>
</html>
