---
import GithubIcon from '@components/icons/GithubIcon.astro';
import LanguagePicker from '@components/ui/LanguagePicker.astro';
import Logo from '@components/ui/Logo.astro';
import SearchTrigger from '@components/ui/SearchTrigger.astro';
import { getCurrentLocale } from '@i18n/utils.ts';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
---

<header
  data-pagefind-ignore
  class:list={[
    'sticky top-0 z-50 flex items-center justify-between gap-4 border-b border-line bg-background px-4 py-2',
    className,
  ]}
>
  <a href={`/${currentLocale}/`}>
    <Logo width={131.25} height={32} />
  </a>
  <SearchTrigger />
  <LanguagePicker placement="bottom" />
  <div class="flex items-center gap-2">
    <a href="https://github.com/withastro/astro" target="_blank">
      <GithubIcon width={24} height={24} class="size-6 text-neutral-50" />
    </a>
    <a href="https://twitter.com/withastro" target="_blank">
      <GithubIcon width={24} height={24} class="size-6 text-neutral-50" />
    </a>
  </div>
</header>
