---
import { Image } from 'astro:assets';
import { getCurrentLocale, useTranslations } from '@shared/i18n/utils.ts';

interface Props {
  class?: string;
  width: number;
  height: number;
}

const { class: className, width, height } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
---

<Image
  src="/logo.webp"
  alt={t('logo.alt')}
  width={width}
  height={height}
  class:list={['h-6 w-auto object-contain', className]}
/>
