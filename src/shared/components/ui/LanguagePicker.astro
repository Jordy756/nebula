---
import { getCurrentLocale, locales, useTranslations } from '@shared/i18n/utils.ts';

interface Props {
  placement?: 'top' | 'bottom' | 'left' | 'right';
}

const { placement = 'top' } = Astro.props;
const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);
const currentPath = Astro.url.pathname.replace(`/${currentLocale}`, '') || '/';
const popoverId = `language-picker-${crypto.randomUUID()}`;

const POSITION_AREA = {
  top: 'position-area-top',
  bottom: 'position-area-bottom',
  left: 'position-area-left',
  right: 'position-area-right',
};
---

<button
  type="button"
  popovertarget={popoverId}
  aria-label={t('languagePicker.label')}
  class="rounded-sm border border-line bg-line/50 px-2 py-1 text-sm transition-opacity hover:opacity-75"
>
  {currentLocale.toUpperCase()}
</button>

<ul
  id={popoverId}
  popover
  class:list={[
    'inset-auto mb-1 flex-col gap-1 rounded-sm border border-line bg-surface p-1 opacity-0 transition-[opacity,overlay,display] transition-discrete duration-350 ease-out open:flex open:opacity-100 starting:open:opacity-0',
    POSITION_AREA[placement],
  ]}
>
  {
    locales.map((locale) => {
      const isCurrent = locale === currentLocale;
      const baseClasses = 'block rounded-xs px-2 py-1 text-sm text-foreground cursor-pointer';

      return (
        <li>
          {isCurrent ? (
            <span class:list={[baseClasses, 'bg-line/50 font-semibold select-none']} aria-current="page">
              {locale.toUpperCase()}
            </span>
          ) : (
            <a
              href={`/${locale}${currentPath}`}
              hreflang={locale}
              class:list={[baseClasses, 'transition-[background-color] hover:bg-line']}
            >
              {locale.toUpperCase()}
            </a>
          )}
        </li>
      );
    })
  }
</ul>
