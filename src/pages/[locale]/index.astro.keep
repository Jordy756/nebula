---
import Footer from '@components/shell/Footer.astro';
import Header from '@components/shell/Header.astro';
import { getCurrentLocale, locales, useTranslations } from '@i18n/utils.ts';
import PageLayout from '@layouts/PageLayout.astro';

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);

const title = 'Nebula';
const description = 'Nebula is a open-source, self-hosted platform for managing your knowledge base.';
---

<PageLayout title={title} description={description}>
  <Header />
  <main class="flex flex-1 flex-col gap-4 p-4">
    <section class="flex max-w-[65ch] flex-1 flex-col items-center justify-center gap-4 self-center text-center">
      <h1>Nebula</h1>
      <p class="text-center">
        Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ducimus excepturi, possimus maxime sunt dolore dicta,
        tempore deleniti quae, vero voluptatum et. Porro quo magni iure ipsum facere harum recusandae reiciendis?
      </p>
      <div class="flex gap-4">
        <a href={`/${currentLocale}/docs/01-getting-started/01-getting-started`}>Get Started</a>
        <a href="#">Github</a>
      </div>
    </section>
  </main>
  <Footer />
</PageLayout>
