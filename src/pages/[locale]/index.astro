---
import { defaultLocale, locales, useTranslations, type Locale } from '@i18n/ui';
import Footer from '@components/layout/Footer.astro';
import Header from '@components/layout/Header.astro';
import Hero from '@components/sections/hero/Hero.astro';
import PageLayout from '@layouts/PageLayout.astro';

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));

const currentLocale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(currentLocale);
const title = t('landing.title');
const description = t('landing.description');
---

<PageLayout title={title} description={description}>
  <Header />
  <main class="flex flex-1 flex-col gap-4 p-4">
    <Hero />
  </main>
  <Footer />
</PageLayout>
