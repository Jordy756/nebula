---
import Footer from '@components/shell/Footer.astro';
import Header from '@components/shell/Header.astro';
import Hero from '@components/sections/hero/Hero.astro';
import { getCurrentLocale, locales, useTranslations } from '@i18n/utils.ts';
import PageLayout from '@layouts/PageLayout.astro';

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));

const currentLocale = getCurrentLocale(Astro.currentLocale);
const t = useTranslations(currentLocale);

const title = 'Nebula';
const description = 'Nebula is a open-source, self-hosted platform for managing your knowledge base.';
---

<PageLayout title={title} description={description}>
  <Header />
  <main class="flex flex-1 flex-col gap-4 p-4">
    <Hero />
  </main>
  <Footer />
</PageLayout>
