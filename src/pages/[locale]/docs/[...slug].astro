---
import Article from '@components/shell/Article.astro';
import TableOfContents from '@components/shell/TableOfContents.astro';
import Blockquote from '@components/mdx/Blockquote.astro';
import Deleted from '@components/mdx/Deleted.astro';
import Emphasis from '@components/mdx/Emphasis.astro';
import HorizontalRule from '@components/mdx/HorizontalRule.astro';
import Img from '@components/mdx/Img.astro';
import Link from '@components/mdx/Link.astro';
import ListItem from '@components/mdx/ListItem.astro';
import OrderedList from '@components/mdx/OrderedList.astro';
import Strong from '@components/mdx/Strong.astro';
import CodeBlockEnhancer from '@components/scripts/CodeBlockEnhancer.astro';
import Table from '@components/mdx/Table.astro';
import TableBody from '@components/mdx/TableBody.astro';
import TableData from '@components/mdx/TableData.astro';
import TableHead from '@components/mdx/TableHead.astro';
import TableHeader from '@components/mdx/TableHeader.astro';
import TableRow from '@components/mdx/TableRow.astro';
import UnorderedList from '@components/mdx/UnorderedList.astro';
import { getCurrentLocale } from '@i18n/utils.ts';
import DocsLayout from '@layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = async () => {
  const docsEntries = await getCollection('docs');
  return docsEntries.map((entry) => {
    const [locale, ...slugParts] = entry.id.split('/');
    return {
      params: { locale, slug: slugParts.join('/') },
      props: { entry },
    };
  });
};

const { entry } = Astro.props;
const { data } = entry;
const { title, description } = data;
const { Content, headings } = await render(entry);
const currentLocale = getCurrentLocale(Astro.currentLocale);
const docs = await getCollection('docs', ({ id }) => id.startsWith(`${currentLocale}/`));
const currentIndex = docs.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? docs[currentIndex - 1] : undefined;
const next = currentIndex < docs.length - 1 ? docs[currentIndex + 1] : undefined;
const prevData = prev
  ? {
      href: `/${currentLocale}/docs/${prev.id.split('/').slice(1).join('/')}`,
      title: prev.data.title,
      description: prev.data.description,
    }
  : undefined;
const nextData = next
  ? {
      href: `/${currentLocale}/docs/${next.id.split('/').slice(1).join('/')}`,
      title: next.data.title,
      description: next.data.description,
    }
  : undefined;
---

<DocsLayout title={title} description={description}>
  <Article title={title} description={description} prev={prevData} next={nextData}>
    <Content
      components={{
        a: Link,
        ul: UnorderedList,
        ol: OrderedList,
        li: ListItem,
        blockquote: Blockquote,
        strong: Strong,
        em: Emphasis,
        del: Deleted,
        hr: HorizontalRule,
        img: Img,
        table: Table,
        thead: TableHead,
        tbody: TableBody,
        tr: TableRow,
        th: TableHeader,
        td: TableData,
      }}
    />
  </Article>
  {headings.length > 0 && <TableOfContents slot="toc" headings={headings} />}
  <CodeBlockEnhancer />
</DocsLayout>
