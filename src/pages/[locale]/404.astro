---
import Footer from '@shared/components/shell/Footer.astro';
import Header from '@shared/components/shell/Header.astro';
import HomeLayout from '@features/home/layouts/HomeLayout.astro';
import { locales } from '@shared/i18n/utils.ts';

export const getStaticPaths = () => locales.map((locale) => ({ params: { locale } }));

const title = '404 - Página no encontrada';
const description = 'La página que estás buscando no existe.';
---

<HomeLayout title={title} description={description}>
  <Header />
  <main class="flex flex-1 flex-col gap-4 p-4">
    <h1>404 - Página no encontrada</h1>
    <p>La página que estás buscando no existe.</p>
  </main>
  <Footer />
</HomeLayout>
