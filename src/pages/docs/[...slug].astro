---
import Article from '@components/layout/Article.astro';
import TableOfContents from '@components/layout/TableOfContents.astro';
import Blockquote from '@components/mdx/Blockquote.astro';
import Deleted from '@components/mdx/Deleted.astro';
import Emphasis from '@components/mdx/Emphasis.astro';
import HorizontalRule from '@components/mdx/HorizontalRule.astro';
import Img from '@components/mdx/Img.astro';
import Link from '@components/mdx/Link.astro';
import ListItem from '@components/mdx/ListItem.astro';
import OrderedList from '@components/mdx/OrderedList.astro';
import Paragraph from '@components/mdx/Paragraph.astro';
import Pre from '@components/mdx/Pre.astro';
import Strong from '@components/mdx/Strong.astro';
import Table from '@components/mdx/Table.astro';
import TableBody from '@components/mdx/TableBody.astro';
import TableData from '@components/mdx/TableData.astro';
import TableHead from '@components/mdx/TableHead.astro';
import TableHeader from '@components/mdx/TableHeader.astro';
import TableRow from '@components/mdx/TableRow.astro';
import UnorderedList from '@components/mdx/UnorderedList.astro';
import DocsLayout from '@layouts/DocsLayout.astro';
import { getCollection, render } from 'astro:content';

export const getStaticPaths = async () => {
  const docsEntries = await getCollection('docs');
  return docsEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { data } = entry;
const { title, description } = data;
const { Content, headings } = await render(entry);
const docsEntries = await getCollection('docs');
const currentIndex = docsEntries.findIndex((e) => e.id === entry.id);
const prev = currentIndex > 0 ? docsEntries[currentIndex - 1] : undefined;
const next = currentIndex < docsEntries.length - 1 ? docsEntries[currentIndex + 1] : undefined;
const prevData = prev
  ? { href: `/docs/${prev.id}`, title: prev.data.title, description: prev.data.description }
  : undefined;
const nextData = next
  ? { href: `/docs/${next.id}`, title: next.data.title, description: next.data.description }
  : undefined;
---

<DocsLayout title={title} description={description}>
  <section class="flex flex-3 flex-col items-center">
    <Article title={title} description={description} prev={prevData} next={nextData}>
      <Content
        components={{
          p: Paragraph,
          a: Link,
          ul: UnorderedList,
          ol: OrderedList,
          li: ListItem,
          blockquote: Blockquote,
          pre: Pre,
          strong: Strong,
          em: Emphasis,
          del: Deleted,
          hr: HorizontalRule,
          img: Img,
          table: Table,
          thead: TableHead,
          tbody: TableBody,
          tr: TableRow,
          th: TableHeader,
          td: TableData,
        }}
      />
    </Article>
  </section>
  {headings.length > 0 && <TableOfContents headings={headings} />}
</DocsLayout>
