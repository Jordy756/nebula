---
import { getCollection, type CollectionEntry } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';

export async function getStaticPaths() {
  const docsEntries = await getCollection('docs');
  return docsEntries.map((entry: CollectionEntry<'docs'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'docs'>;
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings}>
  <h1 class="mb-2 text-3xl font-extrabold tracking-tight text-zinc-900 dark:text-white sm:text-4xl">
    {entry.data.title}
  </h1>
  {entry.data.description && (
    <p class="mb-8 text-lg text-zinc-600 dark:text-zinc-400">
      {entry.data.description}
    </p>
  )}
  <Content />
</DocsLayout>