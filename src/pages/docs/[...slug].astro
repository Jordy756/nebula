---
import { getCollection, render } from 'astro:content';
import DocsLayout from '@layouts/DocsLayout.astro';

export const getStaticPaths = async () => {
  const docsEntries = await getCollection('docs');
  return docsEntries.map((entry) => ({
    params: { id: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocsLayout title={entry.data.title} description={entry.data.description} headings={headings}>
  <h1 class="mb-2 text-3xl font-extrabold tracking-tight text-zinc-900 sm:text-4xl dark:text-white">
    {entry.data.title}
  </h1>
  {entry.data.description && <p class="mb-8 text-lg text-zinc-600 dark:text-zinc-400">{entry.data.description}</p>}
  <Content />
</DocsLayout>
